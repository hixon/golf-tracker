  ],
  "paths": {  
    "/course":{
        "post": {
            "tags": [
            "Course"
            ],
            "description": "Create new course in system",
            "parameters": [
            {
                "name": "course",
                "in": "body",
                "description": "Course that we want to create",
                "schema": {
                "$ref": "#/definitions/Course"
                }
            }
            ],
            "produces": [
            "application/json"
            ],
            "responses": {
            "200": {
                "description": "New course is created",
                "schema": {
                "$ref": "#/definitions/Course"
                }
            }
        }
      }, 
      "get": {
        "tags": [
          "Course"
        ],
        "summary": "Get all courses in system",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/Courses"
            }
          }
        }
      }
    }, 
    "/tee/{courseid}": {
      "parameters": [
        {
          "name": "courseid",
          "in": "path",
          "required": true,
          "description": "ID of course that we want to find",
          "type": "string"
        }
      ],
      "get": {
        "tags": [
          "Tee"
        ],
        "summary": "Get tees from course with given ID",
        "responses": {
          "200": {
            "description": "Tees found",
            "schema": {
              "$ref": "#/definitions/Tees"
            }
          }
        }
      },
      "delete": {
        "summary": "Delete user with given ID",
        "tags": [
          "Tee"
        ],
        "responses": {
          "200": {
            "description": "User is deleted",
            "schema": {
              "$ref": "#/definitions/User"
            }
          }
        }
      },
      "put": {
        "summary": "Update user with give ID",
        "tags": [
          "Tee"
        ],
        "parameters": [
          {
            "name": "tees",
            "in": "body",
            "description": "Tees to add to a given course",
            "schema": {
              "$ref": "#/definitions/Tees"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User is updated",
            "schema": {
              "$ref": "#/definitions/User"
            }
          }
        }
      }
    }
    ,  
    "/users": {
      "post": {
        "tags": [
          "Users"
        ],
        "description": "Create new user in system",
        "parameters": [
          {
            "name": "user",
            "in": "body",
            "description": "User that we want to create",
            "schema": {
              "$ref": "#/definitions/User"
            }
          }
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "New user is created",
            "schema": {
              "$ref": "#/definitions/User"
            }
          }
        }
      },
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get all users in system",
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "$ref": "#/definitions/Users"
            }
          }
        }
      }
    },
    "/users/{userId}": {
      "parameters": [
        {
          "name": "userId",
          "in": "path",
          "required": true,
          "description": "ID of user that we want to find",
          "type": "string"
        }
      ],
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Get user with given ID",
        "responses": {
          "200": {
            "description": "User is found",
            "schema": {
              "$ref": "#/definitions/User"
            }
          }
        }
      },
      "delete": {
        "summary": "Delete user with given ID",
        "tags": [
          "Users"
        ],
        "responses": {
          "200": {
            "description": "User is deleted",
            "schema": {
              "$ref": "#/definitions/User"
            }
          }
        }
      },
      "put": {
        "summary": "Update user with give ID",
        "tags": [
          "Users"
        ],
        "parameters": [
          {
            "name": "user",
            "in": "body",
            "description": "User with new values of properties",
            "schema": {
              "$ref": "#/definitions/User"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User is updated",
            "schema": {
              "$ref": "#/definitions/User"
            }
          }
        }
      }
    }
  },
  "definitions": {
