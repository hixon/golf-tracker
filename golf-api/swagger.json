    {
      "name": "Users",
      "description": "API for users in the system"
    }, 
    {
        "name": "Course", 
        "description": "API calls for courses"
    }, 
    {
        "name": "Tee", 
        "description": "API calls for course tee"
    },
    {
        "name": "Player", 
        "description": "API calls for players"
    },
    {
